{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true,
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"]
        },
        "types": ["vite/client"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts",
        "vite.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
